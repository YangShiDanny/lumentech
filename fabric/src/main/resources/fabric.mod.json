{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/YangShiDanny/lumentech",
        "sources": "https://github.com/YangShiDanny/lumentech"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.lumentech.LumenTechFabric"
        ],
        "client": [
            "com.lumentech.fabric.client.LumenTechFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "*",
        "fabric-api": "*",
        // GeckoLib is only wired on legacy MC (1.x); removed from 26.x builds by stonecutter.
        //? if <1.22 {
        "geckolib": "*",
        //?}
        "minecraft": "*",
        "java": ">=${java_version}"
    },
    "recommends": {
        //? if <1.22 {
        "techreborn": "*"
        //?}
    }
}
